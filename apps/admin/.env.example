# Supabase project connection. Get these from the Supabase dashboard
# (Project Settings -> API) or `supabase projects api-keys --project-ref <ref>`.
# The anon/publishable key is safe to expose client-side by design.
# Copy this to `.env.local` (gitignored) and fill in real values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry error monitoring (Settings -> Projects -> admin -> Client Keys).
# Optional -- leave blank to disable Sentry locally.
VITE_SENTRY_DSN=
